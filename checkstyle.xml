<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Checkstyle configuration for CSC207 Team 8 (MarketLens).

  This is deliberately a working ruleset rather than a token one: `mvn verify`
  fails the build on any violation, so main must stay clean. The conventions
  encoded here are the ones the team already agreed in plan/decisions.md §7.

  Scope: src/main/java only. Test sources are excluded on purpose - test method
  names read better as prose (addTicker_rejectsBlankSymbol) than as camelCase,
  and we would rather not weaken the production naming rule to accommodate them.
-->
<module name="Checker">
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- No tabs anywhere; the project indents with four spaces. -->
    <module name="FileTabCharacter"/>

    <!-- Every file ends with a newline. -->
    <module name="NewlineAtEndOfFile"/>

    <!--
      Line length. The team guidance is ~100 characters; 120 is the enforced
      ceiling so the existing 26 borderline lines do not have to be reflowed
      during presentation week (warning W2-5 in plan/decisions.md).
    -->
    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^\s*\*.*https?://"/>
    </module>

    <module name="TreeWalker">

        <!-- Naming conventions. -->
        <module name="ConstantName"/>
        <module name="LocalVariableName"/>
        <module name="MemberName"/>
        <module name="MethodName"/>
        <!--
          Underscores are allowed in package names on purpose. `data_access`,
          `interface_adapter` and `use_case` are the CSC207 starter-code
          convention that the whole course uses, so the default Sun pattern is
          the wrong rule here rather than the code being wrong.
        -->
        <module name="PackageName">
            <property name="format" value="^[a-z][a-z0-9_]*(\.[a-z][a-z0-9_]*)*$"/>
        </module>
        <module name="ParameterName"/>
        <module name="StaticVariableName"/>
        <module name="TypeName"/>

        <!-- Imports. -->
        <module name="AvoidStarImport"/>
        <module name="IllegalImport"/>
        <module name="RedundantImport"/>
        <module name="UnusedImports"/>

        <!-- Braces are never optional, even around a single statement. -->
        <module name="NeedBraces"/>
        <module name="EmptyStatement"/>
        <!--
          LeftCurly is deliberately not enabled. Several entities express their
          accessors as single-line bodies (`public double getX() { return x; }`),
          which is a defensible style, and reformatting those files during
          presentation week would collide with the open strategy-config PR.
        -->


        <!-- Whitespace. -->
        <module name="GenericWhitespace"/>
        <module name="MethodParamPad"/>
        <module name="NoWhitespaceBefore"/>
        <module name="ParenPad"/>
        <module name="WhitespaceAfter"/>
        <module name="WhitespaceAround">
            <property name="allowEmptyConstructors" value="true"/>
            <property name="allowEmptyMethods" value="true"/>
            <property name="allowEmptyTypes" value="true"/>
            <property name="allowEmptyLambdas" value="true"/>
        </module>

        <!-- Common correctness traps. -->
        <module name="EqualsHashCode"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="StringLiteralEquality"/>
        <module name="MissingSwitchDefault"/>
        <module name="FallThrough"/>
        <module name="OneStatementPerLine"/>
        <module name="UpperEll"/>
        <module name="ModifierOrder"/>

        <!--
          Exception variables must be named, not abbreviated to `e`. This is
          warning W2-3 in plan/decisions.md, and turning it on here is what
          finally closes it.
        -->
        <module name="CatchParameterName">
            <property name="format" value="^(exception|[a-z][a-zA-Z0-9]{3,})$"/>
        </module>

        <!--
          Indentation. This is what catches the misaligned if-blocks in
          MomentumConfiguration.
        -->
        <module name="Indentation">
            <property name="basicOffset" value="4"/>
            <property name="lineWrappingIndentation" value="8"/>
            <property name="forceStrictCondition" value="false"/>
        </module>

        <!-- Javadoc on the public API of the production source. -->
        <module name="JavadocMethod">
            <property name="accessModifiers" value="public"/>
            <property name="allowMissingParamTags" value="true"/>
            <property name="allowMissingReturnTag" value="true"/>
        </module>
        <module name="JavadocType">
            <property name="scope" value="public"/>
        </module>
        <module name="NonEmptyAtclauseDescription"/>
    </module>
</module>
