# Copy this file to `.env` and fill in your own key:
#     cp .env.example .env
#
# Get a free Alpha Vantage key: https://www.alphavantage.co/support/#api-key
#
# The app auto-loads .env from the working directory at startup, so `java -jar`
# and `mvn`/IntelliJ runs pick the key up with no extra steps. A real environment
# variable still wins over the file if you set one:
#     set -a; source .env; set +a        # optional; overrides .env
# ...or add ALPHA_VANTAGE_API_KEY to your IntelliJ Run Configuration
# (Run > Edit Configurations > Environment variables).
#
# With no key set, the app runs offline against sample data (AAPL, MSFT, TSLA only).

ALPHA_VANTAGE_API_KEY=your_key_here
